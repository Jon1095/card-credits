rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only your account can read or write, and only under users/<your user ID>.
    // Replace YOUR_USER_ID with the User UID from Firebase console > Authentication > Users.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && userId == 'YOUR_USER_ID';
    }
    // Everything else is denied by default.
  }
}
