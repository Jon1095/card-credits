{
  "name": "card-credits",
  "private": true,
  "type": "module",
  "description": "Personal credit card credits tracker. The app is static files; this file only drives the tests.",
  "scripts": {
    "test": "node --test 'tests/unit/*.test.js'",
    "test:emulator": "PATH=\"/opt/homebrew/opt/openjdk@21/bin:$PATH\" firebase emulators:exec --only firestore --project demo-card-credits \"node --test --test-concurrency=1 'tests/emulator/*.test.js'\"",
    "test:e2e": "PATH=\"/opt/homebrew/opt/openjdk@21/bin:$PATH\" firebase emulators:exec --only firestore,auth --project demo-card-credits \"node --test --test-concurrency=1 'tests/e2e/*.test.js'\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.32.1",
    "playwright-core": "^1.63.0"
  }
}
